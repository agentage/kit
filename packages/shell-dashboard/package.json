{
  "name": "@agentage/shell-dashboard",
  "version": "0.4.0",
  "description": "The agentage dashboard shell: a built page (dist/index.html and its files) that an app host serves at /. Not an extension: no manifest, no create(ctx), no container",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentage/kit.git",
    "directory": "packages/shell-dashboard"
  },
  "homepage": "https://agentage.io",
  "bugs": {
    "url": "https://github.com/agentage/kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "npm run verify --prefix ../..",
    "prepublishOnly": "npm run verify",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@agentage/app": "*",
    "@agentage/components": "^0.21.0",
    "lucide-react": "^1.74.0"
  },
  "keywords": [
    "agentage",
    "shell",
    "dashboard"
  ]
}
