{
  "name": "@agentage/app",
  "version": "0.1.0",
  "description": "The one import of an agentage app: useAppShell, useAppHost, useAppState, Region, Split and a test host",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentage/platform.git",
    "directory": "packages/app"
  },
  "homepage": "https://agentage.io",
  "bugs": {
    "url": "https://github.com/agentage/platform/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-host": {
      "types": "./dist/test-host.d.ts",
      "default": "./dist/test-host.js"
    },
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "theme.css",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "verify": "npm run verify --prefix ../..",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "keywords": [
    "agentage",
    "app",
    "shell",
    "react"
  ]
}
