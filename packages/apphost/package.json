{
  "name": "@agentage/apphost",
  "version": "0.7.0",
  "description": "The agentage app host program: runs extensions through a runner and serves the combined discovery, the session and the shell",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentage/kit.git",
    "directory": "packages/apphost"
  },
  "homepage": "https://agentage.io",
  "bugs": {
    "url": "https://github.com/agentage/kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agentage-apphost-cloud": "dist/cloud-main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/test-support"
  ],
  "scripts": {
    "verify": "npm run verify --prefix ../..",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@agentage/shell-dashboard": "0.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "semver": "^7.8.6",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@agentage/extension": "~0.25.0"
  },
  "devDependencies": {
    "@agentage/extension": "~0.25.0"
  },
  "keywords": [
    "agentage",
    "apphost"
  ]
}
